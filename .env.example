# Authentication mode:
#   cloudflare           - Verify Cf-Access-Jwt-Assertion header via Cloudflare Access JWKS
#   google               - App-hosted Google OAuth 2.0 / OIDC login
#   cloudflare_or_google - Accept Cloudflare Access JWT if present, otherwise Google OAuth
#   cloudflare_and_google - Require BOTH Cloudflare Access JWT AND Google OAuth session
AUTH_MODE=cloudflare

# Comma-separated allowlist of administrator email addresses (required in production).
ADMIN_ALLOWED_EMAILS=you@example.com

# Cloudflare Access settings (required when AUTH_MODE includes cloudflare):
# Team domain must be https://<team>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=https://replace-with-your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-your-cloudflare-access-aud-tag

# Google OAuth 2.0 / OIDC settings (required when AUTH_MODE includes google):
# Authorized redirect URI: https://admin.cubus.sh/auth/google/callback
# GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Per-service internal Admin API Bearer tokens (matched by normalized service name):
# Copy the matching ADMIN_API_TOKEN from sites/<service>/.env
ADMIN_TOKEN_ARTIFACT=replace-with-artifact-admin-api-token
# ADMIN_TOKEN_CHOICE=replace-with-choice-admin-api-token
# ADMIN_TOKEN_AUDOWN=replace-with-audown-admin-api-token
